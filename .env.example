# Copy to .env.local. Never commit real values.
# Use a SEPARATE Supabase project for development; never point this at production.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Server only. Bypasses row-level security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# LLM provider (matcher explanations only). Leave empty to use the rules-only fallback.
LLM_PROVIDER=none
LLM_API_KEY=

# Passport anchoring (Base Sepolia testnet only). Leave empty to keep events in the outbox.
PASSPORT_CHAIN=base-sepolia
PASSPORT_RPC_URL=https://sepolia.base.org
# Dedicated testnet-only key. Never reuse a key that holds real funds.
PASSPORT_OPERATOR_PRIVATE_KEY=
PASSPORT_EAS_SCHEMA_UID=
